{
  "name": "waheguru-simran",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:usb": "adb reverse tcp:8081 tcp:8081 && REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 APP_VARIANT=development expo run:android --device",
    "ios": "expo run:ios",
    "ios:preview": "expo run:ios --configuration Release --no-bundler",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "android:signing": "node scripts/apply-android-signing.js",
    "android:preview": "cd android && ./gradlew assembleRelease && node -e \"console.log('\\nPreview APK (debug-signed):\\n  android/app/build/outputs/apk/release/app-release.apk\\n')\"",
    "android:release": "npm run android:signing && cd android && ./gradlew bundleRelease",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/hooks": "^100.1.0",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.17",
    "expo-dev-client": "~57.0.19",
    "expo-image": "~57.0.5",
    "expo-intent-launcher": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "patch-package": "^8.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-nitro-player": "^1.7.0-alpha.4",
    "react-native-safe-area-context": "~5.7.0",
    "postinstall": "patch-package",
    "patch:nitro-player": "rm -rf node_modules/react-native-nitro-player/android/.cxx node_modules/react-native-nitro-player/android/build && patch-package react-native-nitro-player --exclude 'android/\\.cxx|android/build'",
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}